# 复制为 .env 后填写。
# 注意：只有 scripts/generate_summaries.py 会自动读取 .env；
# 爬虫（arxiv_crawler.py）和网站构建（build_site.py）只读取系统环境变量，
# 需要修改它们的配置时，请在运行前 export 对应变量。

# ===== 摘要生成（generate_summaries.py，自动读取本文件）=====
# ModelScope API 密钥（必需）
MODELSCOPE_ACCESS_TOKEN=your_api_key_here
# API 基础 URL
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1/
# 逗号分隔的模型列表，按顺序尝试，被限流时切换下一个；设置后忽略 MODELSCOPE_MODEL
# MODELSCOPE_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,ZhipuAI/GLM-5.3
# 未设置 MODELSCOPE_MODELS 时使用的单个模型
MODELSCOPE_MODEL=deepseek-ai/DeepSeek-V3.2
# 单个模型的调用次数（最多 2 次，超过 2 按 2 处理）
API_MAX_RETRIES=3
# 抓取论文 HTML 的重试次数和超时时间（秒）
HTTP_MAX_RETRIES=3
HTTP_TIMEOUT=30
# 论文 HTML 送入模型前截断的最大字符数
HTML_MAX_CHARS=180000
# 每生成 N 篇摘要写入一次 papers.md
BATCH_WRITE_SIZE=5

# ===== arXiv 爬虫（arxiv_crawler.py，需 export 后生效）=====
# 检索语句，支持 arXiv 查询语法
ARXIV_QUERY_KEYWORD=all:"VLA" OR all:"Vision-Language-Action" OR all:"World Action Model" OR all:"World-Action Model" OR all:"action world model"
# 首次运行（papers.md 不存在或为空）时抓取的数量
ARXIV_INIT_RESULTS=500
# 每日增量更新时抓取的数量
ARXIV_DAILY_RESULTS=20
# 每次请求 arXiv API 的分页大小
ARXIV_PAGE_SIZE=20
# 两次 arXiv 请求之间的间隔（秒）
ARXIV_DELAY_SECONDS=10
# 检索失败时的重试次数和重试等待的基础时间（秒）
ARXIV_MAX_RETRIES=3
ARXIV_RETRY_BASE_SECONDS=30

# ===== 网站构建（build_site.py，需 export 后生效）=====
# Google Analytics 4 Measurement ID，留空则不加载 GA
GA_MEASUREMENT_ID=
# 全尺寸首图的外部地址前缀，留空则使用站内相对路径
# PAPER_IMAGE_REMOTE_BASE=https://raw.githubusercontent.com/<用户名>/<仓库名>/master/site
PAPER_IMAGE_REMOTE_BASE=
